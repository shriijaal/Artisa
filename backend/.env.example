# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=artisa_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Set to True only for quick local testing without PostgreSQL (not for production)
USE_SQLITE=False

# CORS (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT (configured for Task 2 — not used yet in Task 1)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Khalti Payment Gateway
# Sandbox: https://dev.khalti.com/api/v2/  |  Production: https://khalti.com/api/v2/
KHALTI_SECRET_KEY=your_sandbox_live_secret_key_here
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_WEBSITE_URL=http://localhost:5173

# Email (Gmail SMTP — future production)
# See settings.py for instructions on enabling SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
